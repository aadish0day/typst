@startuml 03_backend_class_diagram
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 12
skinparam defaultFontColor #212121
skinparam arrowColor #212121
skinparam arrowThickness 1.2
skinparam roundcorner 4
skinparam shadowing false

skinparam class {
  BackgroundColor #F8F9FA
  BorderColor #212121
  BorderThickness 1.2
  HeaderBackgroundColor #E9ECEF
  FontName "Liberation Sans"
  FontSize 12
  FontColor #212121
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #495057
  BorderThickness 1.3
  FontName "Liberation Sans"
  FontSize 13
  FontStyle bold
  FontColor #212121
}

skinparam note {
  BackgroundColor #FFFDF7
  BorderColor #BDBDBD
  BorderThickness 1
  FontName "Liberation Sans"
  FontSize 11
  FontColor #212121
}

package "zawer_backend/models (Mongoose Schemas & ODM)" as ModelsPackage {

  class "User" as UserModel <<Mongoose.Model>> {
    +_id: ObjectId
    +name: String
    +email: String
    +phone: String
    +password: String
    +otpCode: String
    +otpExpiry: Date
    +createdAt: Date
    +updatedAt: Date
  }

  class "Product" as ProductModel <<Mongoose.Model>> {
    +_id: ObjectId
    +id: String
    +name: String
    +category: String
    +description: String
    +price: Number
    +originalPrice: Number
    +discountPercentage: Number
    +isSpecialOffer: Boolean
    +offerTag: String
    +rating: Number
    +images: List<String>
    +reviews: List<ReviewSchema>
    +createdAt: Date
    +updatedAt: Date
  }

  class "ReviewSchema" as ReviewSchema <<Embedded Subdocument>> {
    +_id: ObjectId
    +userId: String
    +userName: String
    +rating: Number
    +comment: String
    +date: Date
  }

  class "Cart" as CartModel <<Mongoose.Model>> {
    +_id: ObjectId
    +userId: String
    +items: List<CartItemSchema>
    +createdAt: Date
    +updatedAt: Date
  }

  class "CartItemSchema" as CartItemSchema <<Embedded Subdocument>> {
    +productId: String
    +quantity: Number
  }

  class "Wishlist" as WishlistModel <<Mongoose.Model>> {
    +_id: ObjectId
    +userId: String
    +items: List<WishlistItemSchema>
    +createdAt: Date
    +updatedAt: Date
  }

  class "WishlistItemSchema" as WishlistItemSchema <<Embedded Subdocument>> {
    +productId: String
  }

  class "Order" as OrderModel <<Mongoose.Model>> {
    +_id: ObjectId
    +userId: String
    +customerName: String
    +phone: String
    +address: String
    +paymentMethod: String
    +items: List<OrderItemSchema>
    +subtotal: Number
    +discountAmount: Number
    +couponCode: String
    +totalAmount: Number
    +status: String
    +trackingNumber: String
    +courierPartner: String
    +currentLocation: String
    +estimatedDelivery: Date
    +aiDeliveryInsight: String
    +timeline: List<TimelineStepSchema>
    +createdAt: Date
    +updatedAt: Date
  }

  class "OrderItemSchema" as OrderItemSchema <<Embedded Subdocument>> {
    +productId: String
    +name: String
    +image: String
    +price: Number
    +quantity: Number
  }

  class "TimelineStepSchema" as TimelineStepSchema <<Embedded Subdocument>> {
    +status: String
    +title: String
    +description: String
    +location: String
    +timestamp: Date
    +isCompleted: Boolean
  }

  class "Offer" as OfferModel <<Mongoose.Model>> {
    +_id: ObjectId
    +code: String
    +title: String
    +description: String
    +discountType: String
    +discountValue: Number
    +maxDiscount: Number
    +minOrderAmount: Number
    +applicableCategory: String
    +startDate: Date
    +expiryDate: Date
    +usageLimit: Number
    +usedCount: Number
    +isActive: Boolean
    +tag: String
    +bannerImage: String
    +terms: List<String>
    +createdAt: Date
    +updatedAt: Date
    +isExpired(): Boolean
    +calculateDiscount(orderAmount: Number): Number
  }

  ProductModel *-- "0..*" ReviewSchema : embeds
  CartModel *-- "0..*" CartItemSchema : embeds
  WishlistModel *-- "0..*" WishlistItemSchema : embeds
  OrderModel *-- "1..*" OrderItemSchema : embeds
  OrderModel *-- "1..*" TimelineStepSchema : embeds
}

package "zawer_backend/controllers (Business Logic)" as ControllersPackage {

  class "AuthController" as AuthController <<Controller Module>> {
    +registerUser(req: Request, res: Response): Promise<Response>
    +loginUser(req: Request, res: Response): Promise<Response>
    +getProfile(req: Request, res: Response): Promise<Response>
    +updateProfile(req: Request, res: Response): Promise<Response>
    +forgotPassword(req: Request, res: Response): Promise<Response>
    +resetPassword(req: Request, res: Response): Promise<Response>
  }

  class "ProductController" as ProductController <<Controller Module>> {
    +getProducts(req: Request, res: Response): Promise<Response>
    +getProductById(req: Request, res: Response): Promise<Response>
    +searchProducts(req: Request, res: Response): Promise<Response>
    +addProductReview(req: Request, res: Response): Promise<Response>
    +getProductReviews(req: Request, res: Response): Promise<Response>
  }

  class "CartController" as CartController <<Controller Module>> {
    +getCart(req: Request, res: Response): Promise<Response>
    +addToCart(req: Request, res: Response): Promise<Response>
    +updateCartQuantity(req: Request, res: Response): Promise<Response>
    +removeFromCart(req: Request, res: Response): Promise<Response>
    +clearCart(req: Request, res: Response): Promise<Response>
  }

  class "WishlistController" as WishlistController <<Controller Module>> {
    +getWishlist(req: Request, res: Response): Promise<Response>
    +addToWishlist(req: Request, res: Response): Promise<Response>
    +removeFromWishlist(req: Request, res: Response): Promise<Response>
  }

  class "OrderController" as OrderController <<Controller Module>> {
    -TRACKING_STAGES: Array<Object>
    -AI_INSIGHTS: Object
    +placeOrder(req: Request, res: Response): Promise<Response>
    +getMyOrders(req: Request, res: Response): Promise<Response>
    +getOrderById(req: Request, res: Response): Promise<Response>
    +getOrderTracking(req: Request, res: Response): Promise<Response>
    +updateOrderStatus(req: Request, res: Response): Promise<Response>
    +findOrderFlexible(query: String, userId: String): Promise<Order>
    -generateInitialTimeline(placedTime: Date): Array<TimelineStepSchema>
    -updateTimelineForStatus(timeline: Array, currentStatus: String): Array<TimelineStepSchema>
  }

  class "OfferController" as OfferController <<Controller Module>> {
    +getAllOffers(req: Request, res: Response): Promise<Response>
    +getDiscountedProducts(req: Request, res: Response): Promise<Response>
    +validateCoupon(req: Request, res: Response): Promise<Response>
    +getOfferByCode(req: Request, res: Response): Promise<Response>
  }
}

package "zawer_backend/middleware & config" as InfraPackage {
  class "AuthMiddleware" as AuthMW <<Middleware>> {
    +authMiddleware(req: Request, res: Response, next: NextFunction): void
  }

  class "DatabaseConfig" as DBConfig <<Configuration>> {
    +connectDB(): Promise<void>
  }
}

' Controller to Model dependencies
AuthController ..> UserModel : manages & queries
ProductController ..> ProductModel : queries & updates reviews
ProductController ..> UserModel : looks up reviewer name
CartController ..> CartModel : creates & updates items
WishlistController ..> WishlistModel : creates & mutates items
OrderController ..> OrderModel : persists orders & tracking
OrderController ..> OfferModel : validates coupon & increments usage
OfferController ..> OfferModel : queries & computes discounts
OfferController ..> ProductModel : filters discounted jewellery

' Middleware association
AuthMW ..> UserModel : attaches decoded JWT (id, email) to req.user
DBConfig ..> ModelsPackage : initiates Mongoose connection pool

@enduml
