' FactStamp — Data Flow Diagram, Level 2
' Drill-down on Level 1 process "1.0 Submit Claim" (and only that process).
' Tool: PlantUML   Build: plantuml -tsvg dfd_level_2.puml
'
' LEVELLING / BALANCE against parent process 1.0 — every boundary flow of 1.0
' in the Level 1 diagram appears here, and no other flow crosses the boundary:
'   IN  : Verifier -> 1.0  "Claim"                  = "Claim Text / Screenshot / Category" -> 1.1
'   IN  : 2.0      -> 1.0  "Duplicate Match"        = "Duplicate Match Result"             -> 1.5
'   OUT : 1.0 -> 2.0       "Normalised Text"        = "Normalised Claim Text"              from 1.4
'   OUT : 1.0 -> D1 Claims "New Claim"              = "New Claim Document"                 from 1.7
'   OUT : 1.0 -> D6 Claim Media "Full Screenshot"   = "Full Screenshot (claim_media)"      from 1.7
'   OUT : 1.0 -> Verifier  "Receipt or Duplicate Warning"                                 from 1.7 / 1.5
' The submitter's uid and display name come from the signed-in session
' (useAuth() in Submit.tsx), not from a read of D2 Users, so D2 appears at
' neither level for 1.0.
' OCR (1.3) reads the original file; compression (1.2) runs in parallel and its
' JPEG goes to 1.6, which derives the 160 px thumbnail stored on the claim.
'
' Rule 2 (Diagram-rules.md): PlantUML has no native DFD notation, so DFD shapes
' are mapped onto the nearest PlantUML constructs:
'   process        -> usecase  (ellipse / bubble)
'   data store     -> database (cylinder)
'   external entity-> rectangle (box)
' Rule 5: no "left to right direction" — A4 portrait, reads top-to-bottom.
'
' LAYOUT: the Graphviz original needed {rank=same}, style=invis spine edges and
' constraint=false. The PlantUML equivalents used here are:
'   -[hidden]->  = invisible spine edge (keeps 1.3 below 1.2 on the spine)
'   -[norank]->  = constraint=false (a flow that must not stretch the spine)
@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 26
skinparam titleFontStyle bold

' Rule 5 (portrait): stretch ranks apart, squeeze columns together.
skinparam ranksep 35
skinparam nodesep 30

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam UsecaseBorderColor black
skinparam UsecaseBorderThickness 2.5
skinparam UsecaseBackgroundColor #F8F9FA
skinparam UsecaseFontSize 19
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor black
skinparam RectangleBorderThickness 2.5
skinparam RectangleBackgroundColor transparent
skinparam RectangleFontSize 20
skinparam RectangleFontStyle bold

skinparam DatabaseBorderColor black
skinparam DatabaseBackgroundColor #F8F9FA
skinparam DatabaseFontSize 19
skinparam DatabaseFontStyle bold

title FactStamp - Data Flow Diagram (Level 2: Submit Claim)

' ---------- External entity ----------
rectangle "Registered\nVerifier" as VER

' ---------- Sub-processes of 1.0 ----------
usecase "Validate Submitter\n& Claim Form" as S11
usecase "Compress Screenshot\nto Base64 Data URI" as S12
usecase "Extract Text\n(Tesseract.js WASM,\n100% Client-Side)" as S13
usecase "Normalise &\nTokenise Claim Text" as S14
' ---------- Neighbouring Level 1 process, shown only as a boundary ----------
' #line.dashed marks it as out of scope (PlantUML resets the stroke width when an
' inline line style is applied, so this box is deliberately drawn thinner).
rectangle "Detect Duplicates\n(Level 1 process — out of scope here)" as P20 #line.dashed
usecase "Evaluate Duplicate\nThreshold" as S15
usecase "Assemble Claim Record\n(pending, 7-day deadline,\n160 px thumbnail)" as S16
usecase "Persist Claim\nDocument" as S17
' ---------- Data stores ----------
database "Claims\n(verifications[] embedded)" as D1
database "Claim Media\n(full screenshots)" as D6

' ---------- Boundary inflows ----------
VER --> S11 : "Claim Text / Screenshot /\nCategory"

' ---------- Internal flows ----------
S11 --> S12 : "Accepted Screenshot File"
S12 -[hidden]-> S13
S11 --> S13 : "Original Image\n(OCR input)"
S13 --> S14 : "OCR-Extracted Text\n+ OCR Confidence"
S11 -[norank]-> S14 : "Typed Claim Text\n(no-image path)"
S12 -[norank]-> S16 : "Compressed Screenshot\n(JPEG, max 1280 px)"

' ---------- Boundary flow out to 2.0 and back ----------
S14 --> P20 : "Normalised Claim Text\n(lowercased token set)"
P20 --> S15 : "Duplicate Match Result\n(similarity, matched claim)"

' ---------- Duplicate decision ----------
S15 -[norank]-> VER : "Duplicate Warning +\nLink to Existing Claim"
S15 --> S16 : "Cleared Unique Claim"

' ---------- Assemble and persist ----------
S16 --> S17 : "Claim Record +\nFull Screenshot"
S17 --> D1 : "New Claim Document"
S17 --> D6 : "Full Screenshot\n(claim_media/{claimId})"
S17 -[norank]-> VER : "Submission Receipt\n(claimId)"
@enduml
