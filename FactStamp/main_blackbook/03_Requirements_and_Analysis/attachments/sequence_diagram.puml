@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 26
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam UsecaseBorderColor black
skinparam UsecaseBorderThickness 2.5
skinparam UsecaseBackgroundColor #F8F9FA
skinparam UsecaseFontSize 19
skinparam UsecaseFontStyle bold

skinparam ActorBorderColor black
skinparam ActorBorderThickness 2.5
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorFontSize 24
skinparam ActorFontStyle bold

skinparam RectangleBorderColor black
skinparam RectangleBorderThickness 2.5
skinparam RectangleBackgroundColor transparent
skinparam RectangleFontSize 20
skinparam RectangleFontStyle bold

title FactStamp - Sequence Diagram\n(Third Verification Completes Consensus)

skinparam ParticipantBorderColor black
skinparam ParticipantBorderThickness 2.5
skinparam ParticipantBackgroundColor #F8F9FA
skinparam ParticipantFontSize 24
skinparam ParticipantFontStyle bold
skinparam SequenceLifeLineBorderColor black
skinparam SequenceLifeLineBorderThickness 2.0
skinparam SequenceMessageAlignment center
skinparam ArrowFontSize 24
skinparam NoteFontSize 17
skinparam NoteFontStyle bold
skinparam maxMessageSize 220
skinparam SequenceGroupHeaderFontSize 22
skinparam SequenceGroupFontSize 22
hide footbox

actor "Registered\nVerifier" as V
participant "VerifyDetail\nUI" as UI
participant "security\n.ts" as SEC
participant "Claims\nContext" as CTX
participant "confidence\nScore.ts" as CONF
database "Firestore" as FS
participant "Cloud Function\nawardVerification\nReputation" as CF

V -> UI : open /verify/:claimId
activate UI
UI -> CTX : getClaimById()
activate CTX
CTX --> UI : pending claim (2 of 3 verdicts)
deactivate CTX
UI -> UI : canVerify()\n[pending,\nnot own claim,\nnot yet voted]

V -> UI : verdict, source URL, explanation
UI -> SEC : validateVerdictExplanation()
activate SEC
SEC --> UI : valid
deactivate SEC

UI -> CTX : addVerification()
activate CTX
CTX -> CTX : append verification\n(count = 3)

group Consensus [count >= 3]
  CTX -> CONF : calculateConfidenceScore()
  activate CONF
  CONF --> CTX : score
  deactivate CONF
  CTX -> CTX : verdict = majority\nstatus = 'verified'
end

CTX -> FS : updateClaimInFirestore()
activate FS
FS -> FS : rules Case C\n(not author,\none verdict each)
FS --> CTX : write accepted
deactivate CTX
CTX --> UI : resolved
UI --> V : "Consensus reached!"\n+ verdict stamp
deactivate UI

FS -> CF : onDocumentUpdated\nclaims/{claimId}
deactivate FS
activate CF
CF -> FS : transaction:\nscore all 3 verifiers\n(+2 agree,\n-1 disagree);\nnew verifier's\ntotalVerifications +1
deactivate CF
@enduml
