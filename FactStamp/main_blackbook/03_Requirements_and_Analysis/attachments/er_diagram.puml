@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 26
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam EntityBorderColor black
skinparam EntityBorderThickness 2.5
skinparam EntityBackgroundColor #F8F9FA
skinparam EntityFontSize 22
skinparam EntityFontStyle bold

skinparam ClassBorderColor black
skinparam ClassBorderThickness 2.5
skinparam ClassBackgroundColor #F8F9FA
skinparam ClassFontSize 22
skinparam ClassFontStyle bold
skinparam ClassAttributeFontSize 18

title FactStamp - ER Diagram

entity "USER" as User {
  * uid : string <<PK>>
  --
  * displayName : string (<= 100)
  * email : string <<unique>>
  avatarUrl : string
  * reputation : integer [0..100] = 50
  * totalVerifications : integer >= 0
  isAdmin : boolean = false
  * joinedAt : timestamp (ISO-8601)
}

entity "CATEGORY_METRIC" as CategoryMetric {
  * category : enum <<PK>>
  ..
  { health, political, religious,
  financial, other }
  ..
  derived at runtime from
  CLAIM (not a stored collection)
  --
  * totalClaims : integer
  * verifiedCount : integer
  * contestedCount : integer
  * lastUpdated : timestamp
}

entity "CLAIM" as Claim {
  * id : string <<PK>>
  --
  * submittedBy : string <<FK USER.uid>>
  * submittedByName : string (<= 100)
  * category : enum <<FK CATEGORY_METRIC>>
  --
  * text : string (10..2000 chars)
  thumbnailUrl : string (<= 60 KB)
  imageUrl : string (legacy claims only)
  hasScreenshot : boolean
  * status : enum { pending, verified }
  verdict : enum { TRUE, FALSE, MISLEADING,
  UNVERIFIABLE, CONTESTED }
  confidenceScore : integer [0..100]
  agreementRatio : float [0..100]
  avgVerifierReputation : float [0..100]
  sourceQualityScore : float [0..100]
  * verificationCount : integer = 0
  --
  * createdAt : timestamp
  * consensusDeadline : timestamp (+7 days)
  * consensusDeadlineMs : integer (epoch ms)
  verifiedAt : timestamp
  adminFlagged : boolean = false
  adminFlaggedAt : timestamp
}

entity "VERIFICATION" as Verification {
  * id : string <<PK>>
  ..
  weak entity: embedded array element
  inside the parent CLAIM document
  --
  * claimId : string <<FK CLAIM.id>>
  * verifierId : string <<FK USER.uid>>
  * verifierName : string (<= 100)
  * verifierReputation : integer [0..100]
  --
  * verdict : enum { TRUE, FALSE,
  MISLEADING, UNVERIFIABLE }
  * sourceUrl : string (http/https, <= 500)
  * sourceQuality : enum { high, medium, low }
  * explanation : string (50..3000 chars)
  * createdAt : timestamp
}

entity "CLAIM_MEDIA" as ClaimMedia {
  * claimId : string <<PK, FK CLAIM.id>>
  --
  * imageUrl : base64 data URI (<= 900 KB)
  * createdAt : timestamp
}

entity "NOTIFICATION" as Notification {
  * id : string <<PK>>
  --
  * userId : string <<FK USER.uid>>
  * type : enum { claim_verified,
  reputation_update, weekly_report,
  verdict_submitted }
  * title : string (<= 200)
  * message : string (<= 2000)
  claimId : string <<FK CLAIM.id>>
  * isRead : boolean = false
  * createdAt : timestamp
}

entity "VERDICT" as Verdict {
  * id : string <<PK>>
  ..
  subcollection under the CLAIM
  document (claims/{claimId}/verdicts);
  sibling of the embedded
  VERIFICATION array rows
  --
  * claimId : string <<FK CLAIM.id>>
  * verifierId : string <<FK USER.uid>>
  * explanation : string (<= 3000)
  * createdAt : timestamp
}

entity "REPORT" as Report {
  * id : string <<PK>>
  --
  * targetType : enum { claim, user,
  verification }
  * targetId : string
  * targetTitle : string (<= 300)
  * reason : enum { misinformation_spam,
  harassment, low_quality_source,
  fake_account, manipulation,
  hate_speech, other }
  * severity : enum { low, medium, high }
  * status : enum { pending,
  investigating, resolved, dismissed }
  * reportedBy : string <<FK USER.uid>>
  * reportedByName : string
  * details : string (<= 3000)
  actionTaken : string
  resolvedAt : timestamp
  resolvedBy : string
  * reportedAt : timestamp
}

entity "AUDIT_LOG" as AuditLog {
  * id : string <<PK>>
  --
  * timestamp : timestamp
  * adminId : string <<FK USER.uid>>
  * adminName : string
  * action : string (<= 200)
  * targetType : enum { claim, user,
  report, system }
  * targetId : string
  * details : string (<= 2000)
}

entity "DUPLICATE_CLUSTER" as DuplicateCluster {
  * id : string <<PK>>
  ..
  derived at runtime by the
  Duplicate detector
  --
  * canonicalClaimId : string <<FK CLAIM.id>>
  * duplicateText : string (normalized)
  * similarityScore : float
  * detectedAt : timestamp
}

CategoryMetric ||--o{ Claim : "aggregates (1..N)"
User ||--o{ Claim : "submits (0..N)"
Claim ||--o{ Verification : "receives (0..3, closes at 3)"
User ||--o{ Verification : "casts (0..N)"
Claim ||--o{ DuplicateCluster : "groups (0..N)"
Claim ||--o| ClaimMedia : "stores screenshot (0..1)"
User ||--o{ Notification : "receives (0..N)"
Claim ||--o{ Verdict : "holds (0..N)\nsubcollection"
User ||--o{ Report : "files (0..N)"
Claim ||--o{ Report : "is reported (0..N)"
User ||--o{ AuditLog : "performs (0..N)\nadmin only"

Verification -[hidden]down-> DuplicateCluster
Notification -[hidden]down- Verdict
Report -[hidden]down- AuditLog

@enduml
