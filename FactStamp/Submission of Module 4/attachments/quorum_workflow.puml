@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 14
skinparam defaultFontStyle bold
skinparam titleFontSize 22
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.0
skinparam ArrowFontSize 13
skinparam ArrowFontStyle bold

skinparam ActivityBorderColor black
skinparam ActivityBorderThickness 2.0
skinparam ActivityBackgroundColor #F8F9FA
skinparam ActivityFontSize 14
skinparam ActivityFontStyle bold

title FactStamp - Module 4: Verifier Workbench Operational Workflow

start
:Verifier Browses /verify Queue;
:Filter by Category (Health, Political, etc.) or Sort by Urgency;
:Select Target Claim Card;
:Load Claim Workbench (/verify/:id);

if (Is Verifier the Submitter of this Claim?) then (yes)
  :Display Self-Verification Warning;
  :Disable Verdict Submission Controls;
  stop
else (no)
endif

if (Has Verifier Already Voted on this Claim?) then (yes)
  :Display "Verdict Already Recorded" Status;
  :Disable Re-voting Controls;
  stop
else (no)
endif

:Examine Forward Body, OCR Extraction & Submitter Notes;
:Conduct Primary Source Research (Fact-Check Archives / Official Portals);
:Select Verdict: [TRUE | FALSE | MISLEADING | UNVERIFIABLE];
:Input Primary Evidentiary URL;
:Client Asserts URL Schema (https?://) & Detects Domain Authority Tier;
:Enter Detailed Rationale (Enforce >= 50 Characters & >= 8 Words);

if (Validation Checks Pass?) then (yes)
  :Click "Submit Verification";
  :Dispatch Atomic Firestore Update;
  :Append Verification Object to claim.verifications[];
  :Increment verificationCount by 1;
  
  if (verificationCount >= 3?) then (Quorum Reached)
    :Invoke calculateConfidenceScore();
    :Resolve Majority Verdict & Compute Score C;
    :Set claim.status = 'verified';
    :Dispatch Reputation Settlement (+2 / -1);
    :Trigger Push Notification to Submitter & Verifiers;
  else (Awaiting Remaining Votes)
    :Update Quorum Progress Stepper (e.g., 2/3);
  endif
  
  :Show Success Confirmation & Return to Queue;
  stop
else (no)
  :Display Inline Form Validation Errors;
  stop
endif

@enduml
