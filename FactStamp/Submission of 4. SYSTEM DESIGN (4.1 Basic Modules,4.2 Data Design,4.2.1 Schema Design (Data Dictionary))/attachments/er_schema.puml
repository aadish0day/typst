@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 14
skinparam defaultFontStyle bold
skinparam titleFontSize 22
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.0
skinparam ArrowFontSize 13
skinparam ArrowFontStyle bold

skinparam EntityBorderColor black
skinparam EntityBorderThickness 2.0
skinparam EntityBackgroundColor #F8F9FA
skinparam EntityFontSize 15
skinparam EntityFontStyle bold

title FactStamp - Entity-Relationship (E-R) Data Model

entity "USERS" as USERS {
  * **uid** : string [PK]
  --
  **displayName** : string
  **email** : string
  **avatarUrl** : string
  **reputation** : int (0-100)
  **totalVerifications** : int
  **isAdmin** : boolean
  **joinedAt** : timestamp
}

entity "CLAIMS" as CLAIMS {
  * **id** : string [PK]
  --
  **text** : string (10-2000 chars)
  **category** : string
  **status** : string ('pending' | 'verified')
  **createdAt** : timestamp
  **consensusDeadline** : timestamp
  **verifiedAt** : timestamp
  **submittedBy** : string [FK -> USERS.uid]
  **submittedByName** : string
  **imageUrl** : string (base64 <= 700KB)
  **verdict** : string
  **confidenceScore** : int (0-100)
  **verificationCount** : int (0-10)
  **agreementRatio** : float
  **avgVerifierReputation** : float
  **sourceQualityScore** : float
  **adminFlagged** : boolean
  **adminFlaggedAt** : timestamp
}

entity "VERIFICATIONS" as VERIFICATIONS {
  * **id** : string [PK]
  --
  **claimId** : string [FK -> CLAIMS.id]
  **verdict** : string
  **sourceUrl** : string (http/https)
  **sourceQuality** : string ('high' | 'med' | 'low')
  **explanation** : string (50-3000 chars)
  **verifierId** : string [FK -> USERS.uid]
  **verifierName** : string
  **verifierReputation** : int
  **createdAt** : timestamp
}

entity "NOTIFICATIONS" as NOTIFICATIONS {
  * **id** : string [PK]
  --
  **userId** : string [FK -> USERS.uid]
  **type** : string
  **title** : string
  **message** : string
  **isRead** : boolean
  **claimId** : string [FK -> CLAIMS.id]
  **createdAt** : timestamp
}

entity "REPORTS" as REPORTS {
  * **id** : string [PK]
  --
  **reportedBy** : string [FK -> USERS.uid]
  **targetType** : string ('claim' | 'user')
  **targetId** : string
  **reason** : string
  **severity** : string
  **targetTitle** : string
  **details** : string
  **status** : string ('open' | 'resolved')
  **createdAt** : timestamp
}

USERS ||--o{ CLAIMS : "submits"
USERS ||--o{ VERIFICATIONS : "records"
CLAIMS ||--|{ VERIFICATIONS : "aggregates (embedded array)"
USERS ||--o{ NOTIFICATIONS : "receives"
USERS ||--o{ REPORTS : "files"
CLAIMS ||--o{ REPORTS : "targeted by"

@enduml
