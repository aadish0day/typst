@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 26
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam UsecaseBorderColor black
skinparam UsecaseBorderThickness 2.5
skinparam UsecaseBackgroundColor #F8F9FA
skinparam UsecaseFontSize 19
skinparam UsecaseFontStyle bold

skinparam ActorBorderColor black
skinparam ActorBorderThickness 2.5
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorFontSize 20
skinparam ActorFontStyle bold

skinparam RectangleBorderColor black
skinparam RectangleBorderThickness 2.5
skinparam RectangleBackgroundColor transparent
skinparam RectangleFontSize 20
skinparam RectangleFontStyle bold

title FactStamp - Sequence Diagram\n(Third Verification Completes Consensus)

skinparam ParticipantBorderColor black
skinparam ParticipantBorderThickness 2.5
skinparam ParticipantBackgroundColor #F8F9FA
skinparam ParticipantFontSize 17
skinparam ParticipantFontStyle bold
skinparam SequenceLifeLineBorderColor black
skinparam SequenceLifeLineBorderThickness 2.0
skinparam SequenceMessageAlignment center
skinparam ArrowFontSize 15
skinparam NoteFontSize 15
skinparam NoteFontStyle bold
skinparam maxMessageSize 190

actor "Registered\nVerifier" as V
participant "VerifyDetail\nUI" as UI
participant "security\n.ts" as SEC
participant "Claims\nContext" as CTX
participant "confidence\nScore.ts" as CONF
database "Firestore" as FS
participant "Notifications\nContext" as NOTIF

V -> UI : open\n/verify/:claimId
activate UI
UI -> CTX : getClaimById()
activate CTX
CTX --> UI : Claim\nstatus='pending'\ncount = 2
deactivate CTX
UI --> V : workbench\n(2 of 3 verdicts)

V -> UI : verdict = FALSE
V -> UI : sourceUrl =\npib.gov.in
UI -> CONF : determineSource\nQuality(url)
activate CONF
CONF --> UI : 'high'
deactivate CONF
UI --> V : "Tier 1 Source"\nread-only,\nauto-derived

V -> UI : explanation\n+ Submit
UI -> UI : URL protocol\nhttp / https

UI -> SEC : sanitizeText\nInput()
activate SEC
SEC --> UI : clean text
UI -> SEC : validateVerdict\nExplanation()
SEC -> SEC : >=50 chars,\n>=8 words,\nanti-spam
SEC --> UI : { valid: true }
deactivate SEC

UI -> CTX : addVerification\n(claimId, data)
activate CTX
CTX -> CONF : determineSource\nQuality()
activate CONF
CONF --> CTX : 'high'
deactivate CONF
CTX -> CTX : append to\nverifications[]
CTX -> CTX : count = 3

group Consensus [count >= 3]
  CTX -> CONF : calculateConfidence\nScore()
  activate CONF
  CONF -> CONF : evaluate agreement\nratio
  CONF -> CONF : determine mean\nreputation
  CONF -> CONF : evaluate mean\nsource quality
  CONF -> CONF : Compute weighted\nconfidence score
  CONF --> CTX : { score,\nagreementRatio }
  deactivate CONF
  CTX -> CTX : verdict =\nmajority (FALSE)
  CTX -> CTX : status =\n'verified'
end

CTX -> FS : updateClaimIn\nFirestore()
activate FS
FS --> CTX : write ack
CTX -> FS : updateUser()\nrep +2, total +1
FS --> CTX : profile updated
deactivate CTX

FS -> NOTIF : onSnapshot:\nclaim_verified
activate NOTIF
NOTIF -> NOTIF : prepend App\nNotification
NOTIF --> V : bell badge\n"Consensus\nReached"
deactivate NOTIF
deactivate FS

UI --> V : toast + verdict\nstamp + score
deactivate UI

note over V, NOTIF
  Quorum is exactly 3 verifications. Had the 7-day
  consensusDeadline elapsed first, expireOverdueClaims()
  would instead settle the claim as status = 'verified'
  with verdict = 'CONTESTED' (system-assigned only).
end note

@enduml
