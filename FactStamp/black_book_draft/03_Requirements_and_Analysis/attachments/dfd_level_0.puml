' FactStamp — Data Flow Diagram, Level 0 (Context Diagram)
' Tool: PlantUML   Build: plantuml -tsvg dfd_level_0.puml
' Rule 2 (Diagram-rules.md): PlantUML has no native DFD notation, so DFD shapes
' are mapped onto the nearest PlantUML constructs:
'   process        -> usecase  (ellipse / bubble)
'   data store     -> database (cylinder)
'   external entity-> rectangle (box)
' Rule 5: no "left to right direction" — A4 portrait, must read top-to-bottom.
' Hidden edges (-[hidden]down->) stand in for Graphviz {rank=same} / style=invis.
@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 26
skinparam titleFontStyle bold

' Rule 5 (portrait): stretch the ranks apart and squeeze the columns together so
' the context diagram stays taller than it is wide on an A4 page.
skinparam ranksep 220
skinparam nodesep 30

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam UsecaseBorderColor black
skinparam UsecaseBorderThickness 2.5
skinparam UsecaseBackgroundColor #F8F9FA
skinparam UsecaseFontSize 19
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor black
skinparam RectangleBorderThickness 2.5
skinparam RectangleBackgroundColor transparent
skinparam RectangleFontSize 20
skinparam RectangleFontStyle bold

skinparam DatabaseBorderColor black
skinparam DatabaseBackgroundColor #F8F9FA
skinparam DatabaseFontSize 19
skinparam DatabaseFontStyle bold

title FactStamp - Data Flow Diagram (Level 0 / Context)

' ---- External entities (rectangles) ----
rectangle "Registered\nVerifier" as VER

' ---- The single Level 0 process (usecase bubble) ----
usecase "\n\n0\nFactStamp\nSystem\n\n" as SYS

rectangle "Visitor\n(Public, Read-Only)" as VIS
rectangle "Administrator" as ADM

' ---- Vertical spine: one entity per rank keeps the context tall, not wide ----
VER -[hidden]down-> SYS
SYS -[hidden]down-> VIS
VIS -[hidden]down-> ADM

' Return flows are written "upper <-- lower" so the rank order stays vertical
' (PlantUML ranks by written order; the arrowhead alone changes direction).
VER --> SYS : "1. Claim Text,\n    Screenshot, Category,\n    Verdict + Source URL"
VER <-- SYS : "2. Submission Receipt,\n    Duplicate Warning,\n    Consensus Notification"

SYS --> VIS : "3. Verified Claim Feed,\n    Confidence Score,\n    Fact-Check Card (PNG),\n    Public Analytics"
SYS <-- VIS : "4. Search Query /\n    Claim Lookup"

SYS <-- ADM : "5. Moderation Action,\n    Report Resolution"
SYS --> ADM : "6. Report Queue,\n    Audit Trail,\n    Platform Metrics"
@enduml
