' FactStamp - PERT Chart (Program Evaluation and Review Technique)
' Chapter 3.3 - Planning and Scheduling
' Build:  plantuml -tsvg pert_chart.puml
'
' Activities and dates come from the FactStamp git history
' (first commit 12 Jul 2026, last committed work 13 Sep 2026); activity A is the
' pre-code planning month from the Project Synopsis, and K is the testing and
' documentation work still in progress. Dependencies are logical (what must
' exist before a task can start), so tasks that could run side by side branch.
' Earliest/latest times and slack are computed with the critical path method
' from each activity's duration in days. Critical path: A > B > C > F > G > J > K = 102 days.

@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 30
skinparam titleFontSize 36
skinparam titleFontStyle bold
skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2
skinparam RectangleBorderColor black
skinparam RectangleFontSize 30
skinparam ranksep 70
skinparam nodesep 60
hide stereotype
title FactStamp - PERT Chart (from Git History)

skinparam rectangle<<Crit>> {
  BorderThickness 5
  BackgroundColor #D9D9D9
}
skinparam rectangle<<Norm>> {
  BorderThickness 2
  BackgroundColor #FFFFFF
}
skinparam usecase<<Milestone>> {
  BorderThickness 4
  BackgroundColor #FFFFFF
  FontSize 30
  FontStyle bold
}
skinparam legendFontSize 26
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor black
skinparam legendBorderThickness 2.5

usecase "START\n1 Jun 2026" as START <<Milestone>>
rectangle "<b>A: Planning and Requirements</b>\n1 Jun – 11 Jul\n41 days · Slack 0" as A <<Crit>>
rectangle "<b>B: UI Prototype and Auth Screens</b>\n12 Jul – 30 Jul\n19 days · Slack 0" as B <<Crit>>
rectangle "<b>C: TypeScript + Live Firebase</b>\n31 Jul – 3 Aug\n4 days · Slack 0" as C <<Crit>>
rectangle "<b>D: Claim and Verification Flow</b>\n4 Aug – 7 Aug\n4 days · Slack 8" as D <<Norm>>
rectangle "<b>E: Analytics Dashboard</b>\n8 Aug – 10 Aug\n3 days · Slack 18" as E <<Norm>>
rectangle "<b>F: Firestore Rules + CSP</b>\n11 Aug – 15 Aug\n5 days · Slack 0" as F <<Crit>>
rectangle "<b>G: Admin Console</b>\n16 Aug – 26 Aug\n11 days · Slack 0" as G <<Crit>>
rectangle "<b>H: Rate Limiting + Queue Fixes</b>\n27 Aug – 4 Sep\n9 days · Slack 2" as H <<Norm>>
rectangle "<b>I: In-Browser OCR Pipeline</b>\n5 Sep – 8 Sep\n4 days · Slack 8" as I <<Norm>>
rectangle "<b>J: Rules Hardening + Cloud Function</b>\n9 Sep – 13 Sep\n5 days · Slack 0" as J <<Crit>>
rectangle "<b>K: Testing and Documentation</b>\n14 Sep – 30 Sep (in progress)\n17 days · Slack 0" as K <<Crit>>
usecase "END\n30 Sep 2026" as END <<Milestone>>

START -[bold]-> A
A -[bold]-> B
B -[bold]-> C
C --> D
C --> E
C -[bold]-> F
F -[bold]-> G
F --> H
D --> I
G -[bold]-> J
H --> J
I --> J
E --> K
J -[bold]-> K
K -[bold]-> END

' side-by-side layout for the parallel tasks
D -[hidden]right- E
E -[hidden]right- F
I -[hidden]right- G
G -[hidden]right- H

legend bottom
  <b>Critical path</b> (shaded, heavy border): START > A > B > C > F > G > J > K > END = 102 days
  Slack = days a task can slip without delaying the critical path
  Dates from the commit history; built by one developer, the tasks ran one after another
end legend
@enduml
