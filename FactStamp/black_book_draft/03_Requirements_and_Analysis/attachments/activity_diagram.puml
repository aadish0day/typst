@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 26
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam UsecaseBorderColor black
skinparam UsecaseBorderThickness 2.5
skinparam UsecaseBackgroundColor #F8F9FA
skinparam UsecaseFontSize 19
skinparam UsecaseFontStyle bold

skinparam ActorBorderColor black
skinparam ActorBorderThickness 2.5
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorFontSize 20
skinparam ActorFontStyle bold

skinparam RectangleBorderColor black
skinparam RectangleBorderThickness 2.5
skinparam RectangleBackgroundColor transparent
skinparam RectangleFontSize 20
skinparam RectangleFontStyle bold

title FactStamp - Activity Diagram (Claim Submission to Consensus Verdict)

skinparam ActivityBorderColor black
skinparam ActivityBorderThickness 2.5
skinparam ActivityBackgroundColor #F8F9FA
skinparam ActivityFontSize 19
skinparam ActivityFontStyle bold
skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBorderThickness 2.5
skinparam ActivityDiamondFontSize 19
skinparam ActivityDiamondFontStyle bold
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 2.5
skinparam PartitionFontSize 20
skinparam PartitionFontStyle bold

start

partition "Ingestion (Module 2)" {
  :Registered Verifier opens /submit;
  if (Input mode?) then (paste text)
    :Type or paste claim text;
  else (upload screenshot)
    :validateImageUpload() then compress\nextension + MIME + magic bytes, max 5 MB;
    :Run Tesseract.js WASM OCR in-browser,\nthen cleanExtractedOcrText() to strip\ntimestamps, ticks and status-bar chrome;
    :Verifier reviews and edits extracted text;
  endif
  :Select claim category\n(health / political / religious /\nfinancial / other);
}

partition "Duplicate Detection (Module 3)" {
  :findDuplicate() on text blur\nToken similarity comparison;
  if (Any matching duplicate claim found?) then (yes - duplicate)
    :Render inline duplicate warning with the\nsimilarity percentage and a link to the\nexisting claim; disable the Submit button;
    :Submission blocked\n(no automatic redirect);
    stop
  else (no - claim is unique)
  endif
}

partition "Claim Creation" {
  :sanitizeTextInput(), then addClaim()\ncreates the Claim document;
  :status = 'pending', verificationCount = 0,\nconsensusDeadline = now + 7 days;
  :Persist to Firestore and publish\nto the verification queue;
}

partition "Peer Verification (Module 4)" {
  repeat
    :Another Registered Verifier opens\nthe claim from /verify;
    :Select verdict from TRUE, FALSE,\nMISLEADING, UNVERIFIABLE\n(CONTESTED is not selectable);
    :Enter source URL and written explanation;
    :Validate URL protocol (http / https only) and\nvalidateVerdictExplanation(): min 50 characters,\nmin 8 words, anti-spam and anti-copy checks;
    :determineSourceQuality(url)\nauto-derived from the cited domain;
    :Append Verification to the embedded array;\nverificationCount = verificationCount + 1;
  repeat while (verificationCount < 3\nAND consensusDeadline not passed?) is (yes - stay pending) not (no - settle now)
}

partition "Consensus and Confidence (Module 5)" {
  if (verificationCount >= 3?) then (yes - quorum reached)
    :verdict = majority verdict\nacross the 3 verifications;
    :calculateConfidenceScore()\nEvaluate agreement ratio, average verifier\nreputation, and source quality score\nto determine final consensus confidence;
  else (no - 7-day window expired)
    :expireOverdueClaims() sweep, run every 60 s,\nforce-settles the claim;
    :verdict = 'CONTESTED'\n(system-assigned, never verifier-chosen);\nconfidenceScore from partial verifications, else 30;
  endif
  :status = 'verified', verifiedAt = now;\nWrite the settled claim back to Firestore;
}

partition "Publication (Modules 6 and 8)" {
  :Award reputation delta to verifiers\n(+2 agree with consensus, -1 disagree);
  :Push claim_verified notification to the bell;\nRender verdict stamp and exportable\nfact-check card on the claim detail page;
}

stop

@enduml
