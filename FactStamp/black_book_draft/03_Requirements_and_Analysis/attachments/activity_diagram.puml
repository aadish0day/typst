@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 26
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam UsecaseBorderColor black
skinparam UsecaseBorderThickness 2.5
skinparam UsecaseBackgroundColor #F8F9FA
skinparam UsecaseFontSize 19
skinparam UsecaseFontStyle bold

skinparam ActorBorderColor black
skinparam ActorBorderThickness 2.5
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorFontSize 20
skinparam ActorFontStyle bold

skinparam RectangleBorderColor black
skinparam RectangleBorderThickness 2.5
skinparam RectangleBackgroundColor transparent
skinparam RectangleFontSize 20
skinparam RectangleFontStyle bold

title FactStamp - Activity Diagram (Claim Submission to Consensus Verdict)

skinparam ActivityBorderColor black
skinparam ActivityBorderThickness 2.5
skinparam ActivityBackgroundColor #F8F9FA
skinparam ActivityFontSize 30
skinparam ActivityFontStyle bold
skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBorderThickness 2.5
skinparam ActivityDiamondFontSize 28
skinparam ActivityDiamondFontStyle bold
skinparam ArrowFontSize 26
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 2.5
skinparam PartitionFontSize 30
skinparam PartitionFontStyle bold
<style>
activityDiagram {
  activity {
    Padding 10
  }
  diamond {
    FontSize 28
    FontStyle bold
  }
  arrow {
    FontSize 26
    FontStyle bold
  }
}
title {
  FontSize 36
}
</style>

start

partition "Ingestion (Module 2)" {
  :User opens the Submit page;
  if (Input type?) then (text)
    :Paste claim text;
  else (screenshot)
    :Validate image (type, max 5 MB);
    :Extract text with in-browser OCR;
    :User reviews the extracted text;
  endif
  :Select claim category;
}

partition "Duplicate Detection (Module 3)" {
  :Compare with existing claims (Jaccard\nsimilarity);
  if (Similarity >= 0.75?) then (yes)
    :Block submission and link the existing claim;
    stop
  else (no)
    :Create pending claim with a 7-day deadline;
  endif
}

partition "Peer Verification (Module 4)" {
  repeat
    :Another verifier opens the claim from the\nqueue;
    :Choose verdict: TRUE, FALSE, MISLEADING or\nUNVERIFIABLE;
    :Add source URL and explanation;
    :Validate explanation and rate source quality;
    :Save the verification;
  repeat while (Fewer than 3 verifications\nand not expired?) is (yes) not (no)
}

partition "Consensus (Module 5)" {
  if (3 verifications?) then (yes)
    :Majority verdict and confidence score (40%\nagreement, 30% reputation, 30% source);
  else (no - deadline passed)
    :Admin runs consensus expiry: verdict\nCONTESTED;
  endif
  :Mark claim verified;
}

partition "Publication (Modules 6 and 8)" {
  fork
    :Update reputation (+2 agree, -1 disagree);
  fork again
    :Notify the submitter;
  fork again
    :Enable fact-check card download;
  end fork
}

stop
@enduml
