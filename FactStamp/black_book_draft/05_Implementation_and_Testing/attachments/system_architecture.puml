@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 26
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam RectangleBorderColor black
skinparam RectangleBorderThickness 2.5
skinparam RectangleBackgroundColor transparent
skinparam RectangleFontSize 20
skinparam RectangleFontStyle bold

skinparam ComponentBorderColor black
skinparam ComponentBorderThickness 2.5
skinparam ComponentBackgroundColor #F8F9FA
skinparam ComponentFontSize 20
skinparam ComponentFontStyle bold

title FactStamp - Overall System Architecture

skinparam ActorBorderThickness 2.5
skinparam DatabaseBorderThickness 2.5
skinparam DatabaseFontSize 19
skinparam PackageBorderThickness 2.5
skinparam PackageFontSize 21
skinparam Ranksep 45
skinparam Nodesep 35

actor "Citizen\nSubmitter" as USER
actor "Verifier\n(reputation 0-100)" as VER
actor "Administrator" as ADM

rectangle "Forwarded misinformation\n<<WhatsApp / social media>>\nplain text or screenshot" as SRC

package "Client-side Pipeline (React 18 SPA - runs entirely in the browser)" as PIPE {

  rectangle "**M2 - Submission and Ingestion**\nSubmit page: paste text OR upload screenshot\nsanitizeTextInput() + validateImageUpload()" as SUB

  rectangle "**M2 - Client-side OCR**\ntesseract.js WebAssembly worker\nextractTextFromImage -> cleanExtractedOcrText\n-> detectClaimCategory (6 categories)" as OCR
  rectangle "imageCompression\ncanvas resize -> base64 data URI\nstored on the claim document" as IMG

  rectangle "**M3 - Duplicate Detection Engine**\nJaccard similarity of token sets\nthreshold >= 0.75" as DUP
  rectangle "Duplicate found:\nuser redirected to the\nexisting claim thread" as DUPHIT

  rectangle "**M4 - Verification Queue**\nVerifyQueue / VerifyDetail\nself-verification blocked, one verdict per user" as QUEUE

  rectangle "Verdict + source URL\n+ explanation\nvalidateVerdictExplanation()\ndetermineSourceQuality(url)" as VOTE

  rectangle "**M5 - Weighted Consensus and Confidence**\n3 verifications required to close a claim\nConfidence = agreement x 0.40\n+ avgReputation x 0.30 + sourceQuality x 0.30" as CONS

  rectangle "**Verdict issued**\nTRUE / FALSE / MISLEADING /\nUNVERIFIABLE / CONTESTED\n+ confidence score 0-100" as VERD

  rectangle "**M6 - Fact-Check Card Generator**\nFactCheckCard + VerdictStamp\nhtml-to-image -> shareable PNG" as CARD
  rectangle "**M7 - Analytics Dashboard**\nrecharts + computeWeeklyReport()\npublic, no sign-in required" as DASH
}

rectangle "**M1 - Auth and Verifier Reputation**\nFirebase Auth (email + Google OAuth)\nreputation +2 on agreeing with consensus,\n-1 on dissenting; login rate limiting" as AUTH

rectangle "**M8 - Security and Notifications**\nXSS sanitisation, session timeout,\nreal-time notification fan-out\nto submitter and verifiers" as SEC

rectangle "**Admin Console** (/admin, unlisted)\nmoderation reports, verdict override,\nreputation management, audit_logs" as ADMIN

package "Backend as a Service - Google Cloud" as BE {
  database "Cloud Firestore\nusers - claims - notifications\nreports - audit_logs\nonSnapshot real-time listeners" as FS
  rectangle "**Firestore Security Rules**\nserver-side enforcement:\nrole checks, ownership,\nfield immutability" as RULES
}

USER --> AUTH : signs in
USER --> SRC : receives and forwards
SRC --> SUB
SUB --> IMG : screenshot path
IMG --> OCR
SUB --> DUP : pasted-text path
OCR --> DUP : extracted text
DUP --> DUPHIT : similarity >= 0.75
DUP --> QUEUE : new claim\nstatus = pending,\nconsensusDeadline set
VER --> QUEUE : claims a\npending claim
QUEUE --> VOTE
VOTE --> CONS
CONS --> VERD : after the 3rd verdict\n(else CONTESTED at deadline)
VERD --> CARD
VERD --> DASH

AUTH --> SUB : authenticated\nsession
AUTH --> QUEUE : supplies verifier\nidentity + reputation
CONS --> AUTH : reputation delta
ADM --> ADMIN
ADMIN --> FS : override / moderate
PIPE --> FS : reads and writes
SEC --> FS : notification\ndocuments
FS ..> RULES : every read and write\nevaluated against

USER -[hidden]right- VER
VER -[hidden]right- ADM
ADMIN -[hidden]down- SEC

@enduml
