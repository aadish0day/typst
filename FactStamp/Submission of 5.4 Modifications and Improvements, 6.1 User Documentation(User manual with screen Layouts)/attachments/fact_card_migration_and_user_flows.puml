@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam defaultFontStyle bold
skinparam titleFontSize 18
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.2
skinparam ArrowFontSize 12
skinparam ArrowFontStyle bold

skinparam PackageBorderColor black
skinparam PackageBorderThickness 2.0
skinparam PackageBackgroundColor #FFFFFF

skinparam ComponentBorderColor black
skinparam ComponentBorderThickness 2.0
skinparam ComponentBackgroundColor #F8F9FA

title FactStamp: Architectural Modifications (5.4) & User Operational Workflows (6.1)

package "5.4 Critical Architectural Evolution: Fact Card Rasterizer Migration" {
  [Legacy JavaScript Canvas Parser\n(legacyCanvas.js)] as LEGACY
  [Tailwind CSS v4 & Saffron Sleek\n(oklch color-brand tokens)] as TOKENS
  [Fatal Parser Crash\n'Unsupported color oklab'] as CRASH
  [Modern html-to-image Pipeline\n(SVG foreignObject -> Native Browser C++)] as MODERN
  [Pixel-Perfect 1080x1080 PNG Export\n(Zero OKLCH Errors, High-DPI 2x)] as SUCCESS

  TOKENS --> LEGACY
  LEGACY --> CRASH : Lexer Failure
  TOKENS --> MODERN
  MODERN --> SUCCESS : Browser-Native Skia/WebKit
}

package "6.1 End-to-End Operational Personas & Lifecycle Workflows" {
  package "Persona 1: Submitter (Citizen)" {
    [Receive WhatsApp Rumor] as P1_REC
    [Submit Text or Screenshot] as P1_SUB
    [Canvas Compression & OCR] as P1_PROC
    [Jaccard Similarity Check] as P1_JAC
    [Download Fact Card & Re-Forward] as P1_SHARE
  }
  
  package "Persona 2: Verifier (Community Researcher)" {
    [Authenticate (Google/Email)\nInit Reputation = 50] as P2_AUTH
    [Browse /verify Queue] as P2_QUEUE
    [Workbench Investigation\n(Primary Sources & Rationale)] as P2_BENCH
    [Cast Structured Verdict] as P2_VOTE
    [Quorum Consensus (+2 / -1 Rep)] as P2_CONS
  }
  
  package "Persona 3: Administrator (Supervisor)" {
    [Access /admin Console] as P3_ADMIN
    [Monitor Backlog & Velocity] as P3_MON
    [Resolve Contested 7-Day Claims] as P3_RESOLVE
  }
}

P1_REC --> P1_SUB
P1_SUB --> P1_PROC
P1_PROC --> P1_JAC
P1_JAC --> P1_SHARE : Duplicate (J >= 0.75)
P1_JAC --> P2_QUEUE : Novel Claim (J < 0.75)

P2_AUTH --> P2_QUEUE
P2_QUEUE --> P2_BENCH
P2_BENCH --> P2_VOTE
P2_VOTE --> P2_CONS : 3-Verifier Quorum
P2_CONS --> SUCCESS : Trigger Card Generation
P2_CONS --> P3_RESOLVE : Timeout / Split Verdict

@enduml
