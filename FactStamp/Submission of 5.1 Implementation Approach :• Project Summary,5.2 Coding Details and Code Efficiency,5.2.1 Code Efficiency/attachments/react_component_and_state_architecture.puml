@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam defaultFontStyle bold
skinparam titleFontSize 18
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.2
skinparam ArrowFontSize 12
skinparam ArrowFontStyle bold

skinparam PackageBorderColor black
skinparam PackageBorderThickness 2.0
skinparam PackageBackgroundColor #FFFFFF

skinparam ComponentBorderColor black
skinparam ComponentBorderThickness 2.0
skinparam ComponentBackgroundColor #F8F9FA

title FactStamp: React 18 Component Architecture & Algorithmic Complexity Mapping

package "Tier 1: Application Shell & Root Providers" {
  [App.tsx (Router, Shell, Suspense)] as APP
  [AuthContext.tsx (Firebase User, JWT Session)] as AUTH_CTX
  [ClaimsContext.tsx (State Engine, localClaimsRef)] as CLAIMS_CTX
  [NotificationsContext.tsx (Toast & Unread Alert State)] as NOTIF_CTX
  [ThemeContext.tsx (OKLCH Dynamic Class Engine)] as THEME_CTX
}

package "Tier 2: View Pages (React Router 6 Outlets)" {
  [Submit.tsx\n(Ingestion)] as P_SUBMIT
  [VerifyQueue.tsx\n(Quorum Backlog)] as P_QUEUE
  [VerifyDetail.tsx\n(Workbench)] as P_WORKBENCH
  [ClaimDetail.tsx\n(Dossier & Card)] as P_DOSSIER
  [Dashboard.tsx\n(Analytics)] as P_DASH
}

package "Tier 3: Domain Components & Algorithmic Subsystems" {
  [Subsystem 1 & 2: Tokenizer & Jaccard\n(duplicateDetection.ts)\nTime: O(L) | O(|A| + |B|)] as ALGO_JAC
  [Subsystem 3: Corpus Duplicate Scanner\n(ClaimsContext findDuplicate)\nTime: O(M * L_avg)] as ALGO_SCAN
  [Subsystem 4: Weighted Consensus Engine\n(confidenceScore.ts)\nTime: O(K) strictly linear] as ALGO_CONS
  [Subsystem 5: Canvas Downscaling Pipeline\n(imageCompression.ts)\nTime: O(W * H + S * W_tgt * H_tgt)] as ALGO_COMP
  [Subsystem 6: html-to-image Rasterizer\n(FactCheckCard.tsx)\nTime: O(V + E + W * H)] as ALGO_RAST
}

APP --> AUTH_CTX
AUTH_CTX --> CLAIMS_CTX
CLAIMS_CTX --> NOTIF_CTX
NOTIF_CTX --> THEME_CTX

THEME_CTX --> P_SUBMIT
THEME_CTX --> P_QUEUE
THEME_CTX --> P_WORKBENCH
THEME_CTX --> P_DOSSIER
THEME_CTX --> P_DASH

P_SUBMIT --> ALGO_COMP : Screenshot Compression
P_SUBMIT --> ALGO_JAC : Input Normalization
P_SUBMIT --> ALGO_SCAN : Linear Cache Scan
P_WORKBENCH --> ALGO_CONS : 3-Verifier Vote
P_DOSSIER --> ALGO_RAST : 1080x1080 PNG Export

@enduml
