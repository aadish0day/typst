@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 16
skinparam defaultFontStyle bold
skinparam titleFontSize 22
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.0
skinparam ArrowFontSize 14
skinparam ArrowFontStyle bold

skinparam ActivityBorderColor black
skinparam ActivityBorderThickness 2.0
skinparam ActivityBackgroundColor #F8F9FA
skinparam ActivityFontSize 15
skinparam ActivityFontStyle bold

title FactStamp - Module 3: Jaccard Duplicate Detection Pipeline

start
:Citizen Submits Claim Text (or OCR Transcribed Text);
:Normalise String: Convert to Lowercase, Strip Punctuation, Collapse Whitespace;
:Tokenise Words & Discard Short Tokens (Length <= 3 Characters);
:Construct Inverted Token Set S_new = { w_1, w_2, ..., w_n };
:Query Active & Resolved Claims Corpus from Firestore;

while (For Each Existing Claim c_i in Corpus)
  :Construct Inverted Token Set S_existing for Claim c_i;
  :Compute Intersection: |S_new ∩ S_existing|;
  :Compute Union: |S_new ∪ S_existing|;
  :Compute Jaccard Score: J = |Intersection| / |Union|;
  if (J > Max_Similarity) then (yes)
    :Update Max_Similarity = J;
    :Set Best_Match_Claim = c_i;
  endif
endwhile

if (Max_Similarity >= 0.75?) then (Duplicate Detected (J >= 0.75))
  :Display Toast: "Duplicate claim detected (Match: J%)";
  :Halt New Document Creation in Firestore;
  :Redirect Citizen Directly to Existing Claim Dossier / Fact Card;
  stop
else (Novel Claim (J < 0.75))
  :Generate New Unique Claim ID;
  :Persist New Claim Document to Firestore with status: 'pending';
  :Dispatch Real-time Event to Verifier Community Quorum Queue;
  :Redirect Submitter to Confirmation Screen;
  stop
endif

@enduml
