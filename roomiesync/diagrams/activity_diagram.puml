@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 28
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 24
skinparam ArrowFontStyle bold

skinparam ActivityBorderColor black
skinparam ActivityBorderThickness 2.5
skinparam ActivityBackgroundColor #F8F9FA
skinparam ActivityFontSize 28
skinparam ActivityFontStyle bold

skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBorderThickness 2.5
skinparam ActivityDiamondFontSize 26
skinparam ActivityDiamondFontStyle bold

skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 2.5
skinparam PartitionFontSize 28
skinparam PartitionFontStyle bold

<style>
activityDiagram {
  activity {
    Padding 10
  }
  diamond {
    FontSize 26
    FontStyle bold
  }
  arrow {
    FontSize 24
    FontStyle bold
  }
}
title {
  FontSize 32
}
</style>

title RoomieSync - Activity Diagram (Property Booking to Agreement Signing)

start

partition "1. Roommate Discovery & Matching" {
  :User fills lifestyle & budget preferences\n(sleep schedule, food, cleanliness);
  :System computes compatibility score [25..99]\nusing weighted matching algorithm;
  if (Compatibility >= 75%?) then (yes)
    :Shortlist roommate candidate\nand exchange direct messages;
  else (no)
    :Browse next recommended profile;
    detach
  endif
}

partition "2. Property Inspection Booking" {
  :Browse and filter verified flat listings;
  :Select property and submit inspection visit request;
  :Landlord receives booking notification;
  if (Landlord accepts visit?) then (yes)
    :Inspection confirmed;\nUser attends physical visit;
  else (no / rescheduled)
    :Notify user and propose alternate slot;
    stop
  endif
}

partition "3. Agreement Drafting & Execution" {
  :Initiate shared rental agreement;
  :Set rent breakdown (50%/50%) and deposit;
  :Generate PDF legal agreement\nwith house rules;
  fork
    :Roommate 1 digitally signs agreement;
  fork again
    :Roommate 2 digitally signs agreement;
  end fork
  :Landlord countersigns agreement;
  :Agreement marked "Approved & Signed";
}

partition "4. Shared Living & Expense Management" {
  :Tenants move into property;
  repeat
    :Roommate logs shared utility / grocery expense;
    :System calculates split shares\nand updates running balance;
    :Settlement confirmation logged;
  repeat while (Tenancy active?) is (yes) not (no)
}

stop
@enduml