@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 28
skinparam titleFontStyle bold

skinparam ranksep 65
skinparam nodesep 35

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam EntityBorderColor black
skinparam EntityBorderThickness 2.5
skinparam EntityBackgroundColor #F8F9FA
skinparam EntityFontSize 22
skinparam EntityFontStyle bold
skinparam ClassAttributeFontSize 17

title RoomieSync - Entity-Relationship (E-R) Diagram

entity "USER" as User {
  * **id** : string <<PK>>
  --
  * name : string
  * email : string <<unique>>
  * password : string (hash)
  * role : enum {user, landlord, mess, admin}
  avatar : string
  * isVerified : boolean = true
  * createdAt : timestamp
}

entity "PROFILE" as Profile {
  * **id** : string <<PK>>
  --
  * userId : string <<FK USER.id>>
  occupation : string
  budget : integer[2]
  foodPref : string
  sleepSchedule : string
  cleanliness : integer [1..5]
  smokingDrinking : string
  hobbies : string[]
  preferredLocation : string
  bio : string
}

entity "FRIEND_REQUEST" as FriendRequest {
  * **id** : string <<PK>>
  --
  * senderId : string <<FK USER.id>>
  * recipientId : string <<FK USER.id>>
  * status : enum {pending, accepted, rejected}
  * type : enum {general, roommate}
  message : string
  createdAt : timestamp
}

entity "CONVERSATION" as Conversation {
  * **id** : string <<PK>>
  --
  * participants : string[2] <<FK USER.id>>
  lastMessage : string
  lastMessageAt : timestamp
  lastMessageBy : string <<FK USER.id>>
  isActive : boolean = true
}

entity "MESSAGE" as Message {
  * **id** : string <<PK>>
  --
  * conversationId : string <<FK CONVERSATION.id>>
  * senderId : string <<FK USER.id>>
  * content : string
  * isRead : boolean = false
  * createdAt : timestamp
}

entity "PROPERTY" as Property {
  * **id** : string <<PK>>
  --
  * ownerId : string <<FK USER.id>>
  * title : string
  * price : number (monthly rent)
  * location : string
  * type : enum {Flat, PG}
  sharingType : string
  amenities : string[]
  images : string[]
  ownerName : string
  ownerContact : string
  * status : enum {verified, pending, rejected}
}

entity "MEAL_PLAN" as MealPlan {
  * **id** : string <<PK>>
  --
  * providerName : string
  * chefName : string
  rating : float
  cuisine : string
  * weeklyPrice : number
  * monthlyPrice : number
  dietary : string
  weeklyMenu : map<day, items>
}

entity "AGREEMENT" as Agreement {
  * **id** : string <<PK>>
  --
  * userId : string <<FK USER.id>>
  * roommate1Name : string
  * roommate2Name : string
  * propertyAddress : string
  * totalRent : number
  * roommate1Share : number = 50%
  * roommate2Share : number = 50%
  * securityDeposit : number
  houseRules : string[]
  * status : string = "Approved & Signed"
}

entity "EXPENSE" as Expense {
  * **id** : string <<PK>>
  --
  * userId : string <<FK USER.id>>
  * title : string
  * amount : number
  * category : enum {Rent, Utilities, Groceries, ...}
  * paidBy : string <<FK USER.id>>
  * splitBetween : string[]
  * status : enum {Pending, Settled}
  date : string
}

entity "NOTIFICATION" as Notification {
  * **id** : string <<PK>>
  --
  * recipientId : string <<FK USER.id>>
  * title : string
  * message : string
  type : string {match, expense, chat}
  * isRead : boolean = false
  * createdAt : timestamp
}

entity "REVIEW" as Review {
  * **id** : string <<PK>>
  --
  * userId : string <<FK USER.id>>
  * targetType : enum {user, property, meal}
  * targetId : string <<FK>>
  authorName : string
  * rating : integer [1..5]
  * comment : string
}

entity "REPORT" as Report {
  * **id** : string <<PK>>
  --
  * reportedBy : string <<FK USER.id>>
  * targetUserId : string <<FK USER.id>>
  * reason : string
  * status : enum {Under Review, User Banned, Resolved}
}

' ---------- Entity Relationships ----------
User ||--|| Profile : "has (1..1)"
User ||--o{ FriendRequest : "sends (0..N)"
User ||--o{ Conversation : "joins (0..N)"
Conversation ||--o{ Message : "contains (1..N)"
User ||--o{ Property : "lists (0..N)"
User ||--o{ Agreement : "executes (0..N)"
User ||--o{ Expense : "pays / splits (0..N)"
User ||--o{ Notification : "receives (0..N)"
User ||--o{ Review : "writes (0..N)"
Property ||--o{ Review : "receives (0..N)"
MealPlan ||--o{ Review : "receives (0..N)"
User ||--o{ Report : "files / reported (0..N)"

' ---------- Vertical Two-Column Layout Spine ----------
User -[hidden]right- Profile
User -[hidden]down- FriendRequest
Profile -[hidden]down- Conversation
Conversation -[hidden]down- Message
FriendRequest -[hidden]down- Property
Message -[hidden]down- MealPlan
Property -[hidden]right- MealPlan
Property -[hidden]down- Agreement
MealPlan -[hidden]down- Expense
Agreement -[hidden]right- Expense
Agreement -[hidden]down- Review
Expense -[hidden]down- Report
Review -[hidden]right- Report
Report -[hidden]down- Notification

@enduml