@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 24
skinparam titleFontSize 32
skinparam titleFontStyle bold
skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam RectangleBorderColor black
skinparam RectangleFontSize 22
skinparam ranksep 60
skinparam nodesep 40
hide stereotype

title RoomieSync - PERT Chart (Critical Path Analysis: 28 Days)

skinparam rectangle<<Crit>> {
  BorderThickness 4.5
  BackgroundColor #E0E0E0
}
skinparam rectangle<<Norm>> {
  BorderThickness 2.0
  BackgroundColor #FFFFFF
}
skinparam usecase<<Milestone>> {
  BorderThickness 3.5
  BackgroundColor #FFFFFF
  FontSize 24
  FontStyle bold
}

skinparam legendFontSize 20
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor black
skinparam legendBorderThickness 2.5

usecase "START\nDay 0" as START <<Milestone>>

rectangle "<b>A: Requirements & SRS</b>\nDay 1 – 3 (3 days)\nSlack: 0" as A <<Crit>>
rectangle "<b>B: Architecture & Schemas</b>\nDay 4 – 7 (4 days)\nSlack: 0" as B <<Crit>>
rectangle "<b>C: User Auth & Profiles</b>\nDay 8 – 11 (4 days)\nSlack: 0" as C <<Crit>>

rectangle "<b>D: Matching Algorithm</b>\nDay 12 – 15 (4 days)\nSlack: 0" as D <<Crit>>
rectangle "<b>E: Property Listings</b>\nDay 12 – 16 (5 days)\nSlack: 2" as E <<Norm>>
rectangle "<b>F: Meal Plan Service</b>\nDay 12 – 14 (3 days)\nSlack: 4" as F <<Norm>>

rectangle "<b>G: Real-Time Chat Engine</b>\nDay 16 – 20 (5 days)\nSlack: 0" as G <<Crit>>
rectangle "<b>H: Rental Agreements & PDF</b>\nDay 17 – 20 (4 days)\nSlack: 1" as H <<Norm>>
rectangle "<b>I: Shared Expenses Tracker</b>\nDay 17 – 19 (3 days)\nSlack: 2" as I <<Norm>>

rectangle "<b>J: System Integration & QA</b>\nDay 21 – 25 (5 days)\nSlack: 0" as J <<Crit>>
rectangle "<b>K: Docker & Cloud Deploy</b>\nDay 26 – 28 (3 days)\nSlack: 0" as K <<Crit>>

usecase "FINISH\nDay 28" as END <<Milestone>>

START -[bold]-> A
A -[bold]-> B
B -[bold]-> C

C -[bold]-> D
C --> E
C --> F

D -[bold]-> G
E --> H
F --> I

G -[bold]-> J
H --> J
I --> J

J -[bold]-> K
K -[bold]-> END

' Layout alignment for parallel tasks
D -[hidden]right- E
E -[hidden]right- F
G -[hidden]right- H
H -[hidden]right- I

legend bottom
  <b>Critical Path (Shaded, Heavy Border)</b>: START > A > B > C > D > G > J > K > FINISH = 28 Days
  Slack = Allowable delay without extending the project completion deadline
end legend

@enduml