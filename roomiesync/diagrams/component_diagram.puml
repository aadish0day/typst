@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 28
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam ComponentBorderColor black
skinparam ComponentBorderThickness 2.5
skinparam ComponentBackgroundColor #F8F9FA
skinparam ComponentFontSize 22
skinparam ComponentFontStyle bold

skinparam DatabaseBorderColor black
skinparam DatabaseBorderThickness 2.5
skinparam DatabaseBackgroundColor #F8F9FA
skinparam DatabaseFontSize 22
skinparam DatabaseFontStyle bold

skinparam PackageBorderColor black
skinparam PackageBorderThickness 2.5
skinparam PackageFontSize 20
skinparam PackageFontStyle bold

skinparam ranksep 40
skinparam nodesep 25

title RoomieSync - Component Diagram (3-Tier Architecture)

package "Presentation Tier (Frontend Client)" {
  component [React 19 SPA] as ReactApp
  component [Socket.IO Client] as SocketClient
  component [Vite & Tailwind UI] as UIComponents
}

package "Application Tier (Backend Node / Express)" {
  component [Express REST API] as RestAPI
  component [Socket.IO Gateway] as SocketServer
  component [Lifestyle Matching Engine] as MatchEngine
  component [PDF Agreement Service] as PDFGen
  component [JWT Authentication] as Auth
}

package "Data & Storage Tier" {
  database "MongoDB 7.0\n(12 Collections)" as Mongo
  component [Cloudinary Media Storage] as Cloudinary
}

' ---------- Tier Relationships ----------
ReactApp --> UIComponents
ReactApp --> SocketClient

ReactApp --> RestAPI : HTTPS / JSON
SocketClient <--> SocketServer : WebSocket (Duplex)

RestAPI --> Auth : verify token
RestAPI --> MatchEngine : compute scores
RestAPI --> PDFGen : render agreement
RestAPI --> Mongo : Mongoose ODM

SocketServer --> Mongo : save messages
RestAPI --> Cloudinary : photo uploads

' ---------- Vertical Stack Spine ----------
ReactApp -[hidden]down- SocketClient
SocketClient -[hidden]down- UIComponents
UIComponents -[hidden]down- RestAPI

RestAPI -[hidden]down- SocketServer
SocketServer -[hidden]down- MatchEngine
MatchEngine -[hidden]down- PDFGen
PDFGen -[hidden]down- Auth

Auth -[hidden]down- Mongo
Mongo -[hidden]down- Cloudinary

@enduml