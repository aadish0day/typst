@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 28
skinparam titleFontStyle bold

skinparam ranksep 60
skinparam nodesep 30

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam ClassBorderColor black
skinparam ClassBorderThickness 2.5
skinparam ClassBackgroundColor #F8F9FA
skinparam ClassFontSize 22
skinparam ClassFontStyle bold
skinparam ClassAttributeFontSize 17

title RoomieSync - Domain Class Diagram

class apiService <<service>> {
  + login(credentials) : Promise
  + register(userData) : Promise
  + getProfile(userId) : Promise
  + updateProfile(userId, data) : Promise
  + getProperties(filters) : Promise
  + addProperty(data) : Promise
  + bookProperty(data) : Promise
  + getMealPlans() : Promise
  + subscribeMeal(id) : Promise
  + getAgreements() : Promise
  + addExpense(data) : Promise
  + reportUser(data) : Promise
}

class socketService <<service>> {
  + connect(userId) : void
  + joinConversation(convId) : void
  + sendMessage(convId, senderId, text) : void
  + sendTyping(convId, userId) : void
  + markRead(convId, readerId) : void
  + on(event, callback) : void
}

class matchingEngine <<service>> {
  + calculateCompatibility(profileA, profileB) : integer [25..99]
}

class User {
  - id : string
  - name : string
  - email : string
  - role : string
  - avatar : string
  - isVerified : boolean
  + register() : boolean
  + login() : Token
}

class Profile {
  - userId : string
  - occupation : string
  - budget : integer[2]
  - foodPref : string
  - sleepSchedule : string
  - cleanliness : integer
  - smokingDrinking : string
  - hobbies : string[]
  + updateProfile() : boolean
}

class FriendRequest {
  - senderId : string
  - recipientId : string
  - status : string
  - type : string
  + accept() : void
  + reject() : void
}

class Conversation {
  - participants : string[2]
  - lastMessage : string
  - lastMessageAt : timestamp
  - isActive : boolean
  + start() : Conversation
}

class Message {
  - conversationId : string
  - senderId : string
  - content : string
  - isRead : boolean
  + send() : Message
}

class Property {
  - ownerId : string
  - title : string
  - price : number
  - location : string
  - type : string
  - status : string
  + addProperty() : Property
  + bookInspection() : void
}

class MealPlan {
  - providerName : string
  - chefName : string
  - rating : float
  - weeklyPrice : number
  - monthlyPrice : number
  + subscribe() : void
}

class Agreement {
  - roommate1Name : string
  - roommate2Name : string
  - totalRent : number
  - roommate1Share : number
  - roommate2Share : number
  - securityDeposit : number
  - status : string
  + signAgreement() : void
}

class Expense {
  - title : string
  - amount : number
  - category : string
  - paidBy : string
  - splitBetween : string[]
  - status : string
  + addExpense() : Expense
  + settleExpense() : void
}

class Review {
  - targetType : string
  - targetId : string
  - rating : integer
  - comment : string
  + submitReview() : void
}

class Report {
  - reportedBy : string
  - targetUserId : string
  - reason : string
  - status : string
  + resolveReport() : void
}

' ---------- Domain Relationships ----------
User "1" *-- "1" Profile : has
User "1" o-- "0..*" FriendRequest : sends/receives
User "2" o-- "0..*" Conversation : participates
Conversation "1" *-- "many" Message : contains
User "1" o-- "0..*" Property : owns
User "1" o-- "0..*" Agreement : executes
User "1" o-- "0..*" Expense : pays / splits
User "1" o-- "0..*" Review : writes
User "1" o-- "0..*" Report : files

apiService ..> User : authenticates
apiService ..> Property : manages
socketService ..> Conversation : syncs
socketService ..> Message : delivers
matchingEngine ..> Profile : scores [25..99]

' ---------- Vertical Two-Column Layout Spine ----------
apiService -[hidden]right- socketService
apiService -[hidden]down- matchingEngine
socketService -[hidden]down- User
matchingEngine -[hidden]right- User
matchingEngine -[hidden]down- Profile
User -[hidden]down- FriendRequest
Profile -[hidden]right- FriendRequest
Profile -[hidden]down- Conversation
FriendRequest -[hidden]down- Message
Conversation -[hidden]down- Property
Message -[hidden]right- Property
Conversation -[hidden]right- Message
Property -[hidden]down- Agreement
Message -[hidden]down- MealPlan
MealPlan -[hidden]down- Expense
Property -[hidden]right- MealPlan
Agreement -[hidden]right- Expense
Agreement -[hidden]down- Review
Expense -[hidden]down- Report
Review -[hidden]right- Report

@enduml