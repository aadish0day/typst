@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 28
skinparam titleFontStyle bold

skinparam ranksep 65
skinparam nodesep 35

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam EntityBorderColor black
skinparam EntityBorderThickness 2.5
skinparam EntityBackgroundColor #F8F9FA
skinparam EntityFontSize 22
skinparam EntityFontStyle bold
skinparam ClassAttributeFontSize 17

title RoomieSync - Database Schema Design (MongoDB Collections)

entity "users" as users {
  * **_id** : ObjectId [PK]
  --
  * **id** : String [INDEX]
  * name : String
  * email : String [UNIQUE, INDEX]
  * password : String (bcrypt hash)
  * role : enum ['user','landlord','mess','admin']
  avatar : String (URL)
  * isVerified : Boolean [default true]
  createdAt : Date
  updatedAt : Date
}

entity "profiles" as profiles {
  * **_id** : ObjectId [PK]
  --
  * **userId** : String [FK -> users.id, INDEX]
  occupation : String
  budget : Array<Number> [min, max]
  foodPref : String [default 'Veg']
  sleepSchedule : String
  cleanliness : Number [1..5, default 4]
  smokingDrinking : String
  hobbies : Array<String>
  preferredLocation : String
  bio : String
}

entity "friendrequests" as friendrequests {
  * **_id** : ObjectId [PK]
  --
  * **senderId** : String [FK -> users.id, INDEX]
  * **recipientId** : String [FK -> users.id, INDEX]
  * status : enum ['pending','accepted','rejected']
  * type : enum ['general','roommate']
  message : String
  createdAt : Date
  --
  [UNIQUE INDEX]: {senderId: 1, recipientId: 1}
}

entity "conversations" as conversations {
  * **_id** : ObjectId [PK]
  --
  * **participants** : Array<String>[2] [INDEX]
  lastMessage : String
  * **lastMessageAt** : Date [INDEX]
  lastMessageBy : String [FK -> users.id]
  isActive : Boolean [default true]
}

entity "messages" as messages {
  * **_id** : ObjectId [PK]
  --
  * **conversationId** : String [FK -> conversations, INDEX]
  * senderId : String [FK -> users.id]
  * content : String
  * isRead : Boolean [default false]
  * **createdAt** : Date [INDEX]
  --
  [COMPOUND INDEX]: {conversationId: 1, createdAt: 1}
}

entity "properties" as properties {
  * **_id** : ObjectId [PK]
  --
  * **id** : String [INDEX]
  * **ownerId** : String [FK -> users.id, INDEX]
  * title : String
  * price : Number [monthly rent]
  * location : String
  * type : enum ['Flat','PG']
  sharingType : String
  amenities : Array<String>
  images : Array<String>
  ownerName : String
  ownerContact : String
  * status : enum ['verified','pending','rejected']
}

entity "mealplans" as mealplans {
  * **_id** : ObjectId [PK]
  --
  * **id** : String [INDEX]
  * providerName : String
  * chefName : String
  rating : Number [default 4.8]
  cuisine : String
  * weeklyPrice : Number
  * monthlyPrice : Number
  dietary : String [default 'Pure Veg']
  weeklyMenu : Map<Day, Items>
}

entity "agreements" as agreements {
  * **_id** : ObjectId [PK]
  --
  * **id** : String [INDEX]
  * **userId** : String [FK -> users.id, INDEX]
  * roommate1Name : String
  * roommate2Name : String
  * propertyAddress : String
  * totalRent : Number
  * roommate1Share : Number [default 50%]
  * roommate2Share : Number [default 50%]
  * securityDeposit : Number [default 50000]
  houseRules : Array<String>
  * status : String [default 'Approved & Signed']
}

entity "expenses" as expenses {
  * **_id** : ObjectId [PK]
  --
  * **id** : String [INDEX]
  * **userId** : String [FK -> users.id, INDEX]
  * title : String
  * amount : Number
  * category : enum ['Rent','Utilities','Groceries',...]
  * **paidBy** : String [FK -> users.id, INDEX]
  splitBetween : Array<String>
  * status : enum ['Pending','Settled']
  date : String
}

entity "notifications" as notifications {
  * **_id** : ObjectId [PK]
  --
  * **id** : String [INDEX]
  * **recipientId** : String [FK -> users.id, INDEX]
  * title : String
  * message : String
  type : String [default 'general']
  * isRead : Boolean [default false]
  createdAt : Date
}

entity "reviews" as reviews {
  * **_id** : ObjectId [PK]
  --
  * **id** : String [INDEX]
  * **userId** : String [FK -> users.id, INDEX]
  * targetType : enum ['user','property','meal']
  * **targetId** : String [INDEX]
  authorName : String
  * rating : Number [1..5]
  * comment : String
}

entity "reports" as reports {
  * **_id** : ObjectId [PK]
  --
  * **id** : String [INDEX]
  * **reportedBy** : String [FK -> users.id, INDEX]
  * **targetUserId** : String [FK -> users.id, INDEX]
  * reason : String
  * status : enum ['Under Review','User Banned','Resolved']
}

' ---------- Relations ----------
users ||--|| profiles : "userId"
users ||--o{ friendrequests : "sender / recipient"
users ||--o{ conversations : "participant"
conversations ||--o{ messages : "conversationId"
users ||--o{ properties : "ownerId"
users ||--o{ agreements : "userId"
users ||--o{ expenses : "paidBy"
users ||--o{ notifications : "recipientId"
users ||--o{ reviews : "userId"
properties ||--o{ reviews : "targetId"
mealplans ||--o{ reviews : "targetId"
users ||--o{ reports : "reportedBy / target"

' ---------- Vertical Two-Column Layout Spine ----------
users -[hidden]right- profiles
users -[hidden]down- friendrequests
profiles -[hidden]down- conversations
conversations -[hidden]down- messages
friendrequests -[hidden]down- properties
messages -[hidden]down- mealplans
properties -[hidden]right- mealplans
properties -[hidden]down- agreements
mealplans -[hidden]down- expenses
agreements -[hidden]right- expenses
agreements -[hidden]down- reviews
expenses -[hidden]down- reports
reviews -[hidden]right- reports
reports -[hidden]down- notifications

@enduml