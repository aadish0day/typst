@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 26
skinparam titleFontStyle bold

skinparam ranksep 60
skinparam nodesep 25

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam UsecaseBorderColor black
skinparam UsecaseBorderThickness 2.5
skinparam UsecaseBackgroundColor #F8F9FA
skinparam UsecaseFontSize 19
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor black
skinparam RectangleBorderThickness 2.5
skinparam RectangleBackgroundColor transparent
skinparam RectangleFontSize 20
skinparam RectangleFontStyle bold

skinparam DatabaseBorderColor black
skinparam DatabaseBorderThickness 2.5
skinparam DatabaseBackgroundColor #F8F9FA
skinparam DatabaseFontSize 19
skinparam DatabaseFontStyle bold

title RoomieSync - Data Flow Diagram (Level 2: Real-Time Chat Subsystem)

' ---------- Nodes ----------
rectangle "Sender\n(Roommate 1)" as SENDER
usecase "4.1 Socket Auth\n& Room Joining" as P41
database "D_AUTH: Active Sessions\n& JWT Store" as DAUTH
usecase "4.2 Validate & Sanitize\nMessage Content" as P42
usecase "4.3 Persist Message\n& Update Conversation" as P43
database "D_MSG: Messages\n& Conversations" as DMSG
usecase "4.4 Dispatch Real-Time\nDuplex Broadcast" as P44
rectangle "Recipient\n(Roommate 2)" as RECIPIENT
usecase "4.5 Process Read Receipt\n& Presence Update" as P45

' ---------- Vertical Spine ----------
SENDER -[hidden]down- P41
P41 -[hidden]down- DAUTH
DAUTH -[hidden]down- P42
P42 -[hidden]down- P43
P43 -[hidden]down- DMSG
DMSG -[hidden]down- P44
P44 -[hidden]down- RECIPIENT
RECIPIENT -[hidden]down- P45

' ---------- Data Flows ----------
SENDER --> P41 : "JWT Token,\nConversation ID"
P41 <--> DAUTH : "Validate session"
P41 --> P42 : "Authenticated stream"

SENDER --> P42 : "Chat payload (text, timestamp)"
P42 --> P43 : "Sanitized message"

P43 <--> DMSG : "Insert Message doc,\nUpdate lastMessageAt"

P43 --> P44 : "Committed message"
P44 --> RECIPIENT : "receive_message event\n(Instant delivery)"
P44 --> SENDER : "Delivery ACK (1 tick)"

RECIPIENT --> P45 : "message_read event"
P45 <--> DMSG : "Set isRead = true"
P45 --> SENDER : "read_receipt event\n(2 blue ticks)"

@enduml