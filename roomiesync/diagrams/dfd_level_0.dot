digraph DFD_Level_0 {
  rankdir=LR;
  bgcolor="#FFFFFF";
  fontname="Liberation Sans";
  fontsize=13;
  label="RoomieSync - Context Data Flow Diagram (Level 0)";
  labelloc="t";
  nodesep=0.7;
  ranksep=1.0;
  splines=true;

  node [fontname="Liberation Sans", fontsize=10, shape=box, style="filled", fillcolor="#FFFFFF", color="#212121", penwidth=1.3];
  edge [fontname="Liberation Sans", fontsize=9, color="#212121", penwidth=1.1, arrowsize=0.8];

  // External Entities
  USER [label="Roommate / User\n(Flatmate Seeker)", fillcolor="#FAFAFA", width=1.8, height=0.9];
  LANDLORD [label="Property Landlord\n(Owner / Agent)", fillcolor="#FAFAFA", width=1.8, height=0.9];
  MESS [label="Mess / Tiffin Provider", fillcolor="#FAFAFA", width=1.8, height=0.9];
  ADMIN [label="System Administrator", fillcolor="#FAFAFA", width=1.8, height=0.9];

  // Central System Process
  SYSTEM [label="0.0\nRoomieSync Core Platform\n(Compatibility & Housing Engine)", shape=circle, width=2.4, height=2.4, fillcolor="#F1F3F5", style="filled", penwidth=1.5];

  // User Flows
  USER -> SYSTEM [label="1. Reg / Login Credentials\n2. Profile & Lifestyle Criteria\n3. Match Inquiries & Friend Requests\n4. Property Visit Bookings\n5. Agreement Terms & Signatures\n6. Real-Time Chat & Expenses"];
  SYSTEM -> USER [label="1. Authenticated Session\n2. Compatibility Match Scores\n3. Real-Time Messages & Alerts\n4. Booking Confirmation\n5. Signed PDF Agreement\n6. Split Expense Ledger"];

  // Landlord Flows
  LANDLORD -> SYSTEM [label="1. Property Details & Pricing\n2. Ownership Verification Proof\n3. Visit Slot Availability\n4. Agreement Terms Approval"];
  SYSTEM -> LANDLORD [label="1. Verification Status\n2. Tenant Visit Requests\n3. Executed Lease Documents\n4. Tenant Review Summary"];

  // Mess Provider Flows
  MESS -> SYSTEM [label="1. Menu & Subscription Rates\n2. Meal Delivery Availability"];
  SYSTEM -> MESS [label="1. Subscriber Rosters\n2. Order Confirmations"];

  // Admin Flows
  ADMIN -> SYSTEM [label="1. Verification Approvals\n2. Moderation & Ban Actions\n3. Policy Updates"];
  SYSTEM -> ADMIN [label="1. Abuse Reports & Logs\n2. Platform Activity Metrics"];
}
