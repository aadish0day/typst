@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 28
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam NodeBorderColor black
skinparam NodeBorderThickness 2.5
skinparam NodeBackgroundColor #F8F9FA
skinparam NodeFontSize 22
skinparam NodeFontStyle bold

skinparam ArtifactBorderColor black
skinparam ArtifactBorderThickness 2.0
skinparam ArtifactBackgroundColor #FFFFFF
skinparam ArtifactFontSize 18
skinparam ArtifactFontStyle bold

skinparam DatabaseBorderColor black
skinparam DatabaseBorderThickness 2.5
skinparam DatabaseBackgroundColor #F8F9FA
skinparam DatabaseFontSize 22
skinparam DatabaseFontStyle bold

skinparam ranksep 40
skinparam nodesep 25

title RoomieSync - Deployment Diagram (Docker Architecture)

node "Client Device (Mobile / Desktop)" as ClientNode {
  artifact "Modern Web Browser\n(Chrome / Safari / Firefox)" as Browser
}

node "Cloud VM / Host Server (Ubuntu Linux)" as HostNode {

  node "Docker Bridge (roomiesync-net)" as DockerNet {

    node "Frontend Container\n(Nginx Alpine : Port 3000)" as FrontendCont {
      artifact "React 19 SPA Build\n(Static Assets)" as WebAssets
    }

    node "Backend Container\n(Node.js 20 : Port 5000)" as BackendCont {
      artifact "Express REST API" as APIServer
      artifact "Socket.IO Server" as WSServer
    }

    node "Database Container\n(Mongo 7.0 : Port 27017)" as MongoCont {
      database "MongoDB Engine\n(12 Collections)" as MongoEngine
    }
  }

  database "Named Volume\n(mongodb_data : /data/db)" as VolumeStore
}

node "Third-Party Services" as CloudTier {
  artifact "Cloudinary CDN\n(Image Hosting)" as Cloudinary
}

' ---------- Connections ----------
Browser --> WebAssets : HTTPS:3000\n(Page Load)
Browser --> APIServer : HTTPS:5000\n(REST API)
Browser <--> WSServer : WSS:5000\n(Duplex)

APIServer --> MongoEngine : Native Driver\n(Port 27017)
WSServer --> MongoEngine : Persist Chat
MongoCont --> VolumeStore : Mount /data/db
APIServer --> Cloudinary : HTTPS API

' ---------- Strict Vertical Spine ----------
ClientNode -[hidden]down- HostNode
FrontendCont -[hidden]down- BackendCont
BackendCont -[hidden]down- MongoCont
DockerNet -[hidden]down- VolumeStore
HostNode -[hidden]down- CloudTier

@enduml