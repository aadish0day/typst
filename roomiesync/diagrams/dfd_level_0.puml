@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 26
skinparam titleFontStyle bold

skinparam ranksep 220
skinparam nodesep 30

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam UsecaseBorderColor black
skinparam UsecaseBorderThickness 2.5
skinparam UsecaseBackgroundColor #F8F9FA
skinparam UsecaseFontSize 22
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor black
skinparam RectangleBorderThickness 2.5
skinparam RectangleBackgroundColor transparent
skinparam RectangleFontSize 20
skinparam RectangleFontStyle bold

title RoomieSync - Data Flow Diagram (Level 0 / Context Diagram)

' ---- External Entities ----
rectangle "Roommate / User" as USER
usecase "0.0 RoomieSync\nPlatform" as SYS
rectangle "Property Landlord" as LANDLORD
rectangle "Mess Provider" as MESS
rectangle "Administrator" as ADMIN

' ---- Vertical Spine ----
USER -[hidden]down-> SYS
SYS -[hidden]down-> LANDLORD
LANDLORD -[hidden]down-> MESS
MESS -[hidden]down-> ADMIN

' ---- Data Flows ----
USER --> SYS : "Credentials, Profile,\nMatch requests,\nSignatures, Expenses"
USER <-- SYS : "Compatibility scores,\nRoommates, Lease PDF,\nLedger balance"

SYS <-- LANDLORD : "Listings, Availability,\nCountersignature"
SYS --> LANDLORD : "Booking requests, KYC,\nExecuted agreements"

SYS <-- MESS : "Meal plans, Menus"
SYS --> MESS : "Tenant subscriptions,\nMeal orders"

SYS <-- ADMIN : "Verifications, Bans"
SYS --> ADMIN : "Abuse reports, Metrics"

@enduml