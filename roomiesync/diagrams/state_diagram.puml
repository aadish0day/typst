@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 28
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam StateBorderColor black
skinparam StateBorderThickness 2.5
skinparam StateBackgroundColor #F8F9FA
skinparam StateFontSize 22
skinparam StateFontStyle bold
skinparam StateAttributeFontSize 17
skinparam nodesep 30
skinparam ranksep 60

title RoomieSync - State Diagram (Rental Agreement Lifecycle)

state "Draft" as Draft {
}
Draft : status = 'Draft'
Draft : roommate1Share = 50%
Draft : roommate2Share = 50%
Draft : deposit = ₹50,000 (default)
Draft : --
Draft : house rules specified

state "PartiallySigned" as Partial {
}
Partial : status = 'Partially Signed'
Partial : 1 of 2 roommates signed
Partial : awaiting remaining tenant

state "AwaitingLandlord" as PendingLandlord {
}
PendingLandlord : status = 'Pending Landlord Approval'
PendingLandlord : both roommates signed
PendingLandlord : inspection completed

state "ApprovedAndSigned" as Approved {
}
Approved : status = 'Approved & Signed'
Approved : landlord countersigned
Approved : legal PDF generated
Approved : --
Approved : shared expense ledger active

state "Terminated" as Terminated {
}
Terminated : status = 'Terminated'
Terminated : lease duration completed
Terminated : expenses settled & deposit refunded

state "Cancelled" as Cancelled {
}
Cancelled : status = 'Cancelled'
Cancelled : proposal rejected or withdrawn

' ---------- Strict Vertical Spine ----------
Draft -[hidden]-> Partial
Partial -[hidden]-> PendingLandlord
PendingLandlord -[hidden]-> Approved
Approved -[hidden]-> Terminated
Partial -[hidden]right-> Cancelled

[*] --> Draft : initiateAgreement()\n[Match accepted]

Draft --> Partial : signAgreement(roommate1)\n[First signature recorded]

Draft --> Cancelled : cancelAgreement()\n[Withdrawn by roommate]

Partial --> PendingLandlord : signAgreement(roommate2)\n[Both signatures recorded]

Partial --> Cancelled : cancelAgreement()\n[Withdrawn before full execution]

PendingLandlord --> Approved : countersignAgreement(landlord)\n[Landlord validates KYC & deposit]

PendingLandlord --> Cancelled : rejectAgreement(landlord)\n[Terms rejected by landlord]

Approved --> Terminated : concludeTenancy()\n[All expenses marked 'Settled'\nand deposit refunded]

Approved --> [*]
Terminated --> [*]
Cancelled --> [*]

@enduml