@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 28
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 20
skinparam ArrowFontStyle bold

skinparam ParticipantBorderColor black
skinparam ParticipantBorderThickness 2.5
skinparam ParticipantBackgroundColor #F8F9FA
skinparam ParticipantFontSize 22
skinparam ParticipantFontStyle bold

skinparam ActorBorderColor black
skinparam ActorBorderThickness 2.5
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorFontSize 22
skinparam ActorFontStyle bold

skinparam SequenceLifeLineBorderColor black
skinparam SequenceLifeLineBorderThickness 2.0
skinparam SequenceMessageAlignment center
skinparam NoteFontSize 18
skinparam NoteFontStyle bold
skinparam maxMessageSize 160
hide footbox

title RoomieSync - Sequence Diagram\n(Real-Time Messaging & Read Receipts)

actor "Aarav\n(Sender)" as U1
participant "React\nClient" as UI
participant "Socket.IO\nService" as WS
database "MongoDB\nCluster" as DB
actor "Ananya\n(Recipient)" as U2

U1 -> UI : Click Send Message
activate UI

UI -> WS : emit("send_message",\n{convId, content})
activate WS

WS -> DB : Message.create(\n{content, isRead: false})
activate DB
DB --> WS : savedMsg record
deactivate DB

WS -> DB : Conversation.update(\n{lastMessageAt: now})
activate DB
DB --> WS : ack
deactivate DB

WS -> UI : emit("receive_message",\nsavedMsg)
WS -> U2 : emit("receive_message",\nsavedMsg)
deactivate WS

UI --> U1 : Render Sent (1 tick)
deactivate UI

activate U2
U2 -> WS : emit("message_read",\n{convId, msgId})
activate WS

WS -> DB : Message.update(\n{isRead: true})
activate DB
DB --> WS : writeAck
deactivate DB

WS -> UI : emit("read_receipt",\n{convId, readAt})
deactivate WS

UI --> U1 : Render Read (2 blue ticks)
deactivate U2

@enduml