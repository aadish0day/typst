@startuml
skinparam style strictuml
skinparam monochrome true
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 20
skinparam defaultFontStyle bold
skinparam titleFontSize 28
skinparam titleFontStyle bold

skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowThickness 2.5
skinparam ArrowFontSize 17
skinparam ArrowFontStyle bold

skinparam UsecaseBorderColor black
skinparam UsecaseBorderThickness 2.5
skinparam UsecaseBackgroundColor #F8F9FA
skinparam UsecaseFontSize 19
skinparam UsecaseFontStyle bold

skinparam ActorBorderColor black
skinparam ActorBorderThickness 2.5
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorFontSize 20
skinparam ActorFontStyle bold

skinparam RectangleBorderColor black
skinparam RectangleBorderThickness 2.5
skinparam RectangleBackgroundColor transparent
skinparam RectangleFontSize 20
skinparam RectangleFontStyle bold

skinparam PackageBorderColor black
skinparam PackageBorderThickness 2.0
skinparam PackageFontSize 18
skinparam PackageFontStyle bold

skinparam nodesep 20
skinparam ranksep 35

title RoomieSync - Use Case Diagram

actor "Roommate / Seeker" as User
actor "Property Landlord" as Landlord
actor "Administrator" as Admin

rectangle "RoomieSync System Boundary" {

  package "A. Authentication & Matching" {
    usecase "Register & Login" as UC1
    usecase "Manage Lifestyle Profile" as UC2
    usecase "Send Roommate Request" as UC3
    usecase "Calculate Compatibility" as UC4
  }

  package "B. Accommodation & Booking" {
    usecase "Browse & Filter Listings" as UC5
    usecase "Book Inspection Visit" as UC6
    usecase "Post Property Listing" as UC7
    usecase "Manage Availability Slots" as UC8
  }

  package "C. Shared Living & Tenancy" {
    usecase "Draft & Sign Agreement" as UC9
    usecase "Generate Agreement PDF" as UC10
    usecase "Log & Split Expenses" as UC11
    usecase "Settle Monthly Ledger" as UC12
  }

  package "D. Trust & Moderation" {
    usecase "Submit User Review" as UC13
    usecase "Report Inappropriate Content" as UC14
    usecase "Verify Property Listing" as UC15
    usecase "Resolve Abuse Reports" as UC16
  }
}

' --- Force a single vertical column ---
UC1 -[hidden]down- UC2
UC2 -[hidden]down- UC3
UC3 -[hidden]down- UC4
UC4 -[hidden]down- UC5
UC5 -[hidden]down- UC6
UC6 -[hidden]down- UC7
UC7 -[hidden]down- UC8
UC8 -[hidden]down- UC9
UC9 -[hidden]down- UC10
UC10 -[hidden]down- UC11
UC11 -[hidden]down- UC12
UC12 -[hidden]down- UC13
UC13 -[hidden]down- UC14
UC14 -[hidden]down- UC15
UC15 -[hidden]down- UC16

' --- Pin actors beside their respective functional packages ---
UC4 -[hidden]down- Landlord
UC8 -[hidden]down- Admin

' --- User Associations ---
User --> UC1
User --> UC2
User --> UC3
UC3 ..> UC4 : <<include>>
User --> UC5
User --> UC6
User --> UC9
UC9 ..> UC10 : <<include>>
User --> UC11
User --> UC12
User --> UC13
User --> UC14

' --- Landlord Associations ---
Landlord --> UC7
Landlord --> UC8
Landlord --> UC6
Landlord --> UC9

' --- Admin Associations ---
Admin --> UC15
Admin --> UC16

@enduml